# Copy to .env.local (already git-ignored) and fill in real values.
# Never commit real tokens.

# Optional. Only needed to target a Gateway other than the ambient local
# one already configured for the `openclaw` CLI on this machine. If unset,
# the CLI falls back to ~/.openclaw/openclaw.json's stored credentials.
# OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
# OPENCLAW_GATEWAY_TOKEN=

# Optional overrides (defaults shown):
# OPENCLAW_AGENT_ID=main
# OPENCLAW_CLI_PATH=openclaw
# CHAT_BACKEND=openclaw   # set to "mock" to use the local mock engine instead
